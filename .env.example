# FastEDL Backend Environment Configuration
PROJECT_NAME="FastEDL API"
FULL_NAME="Fast Easy Download Link"
TAGLINE="Download. Save. Enjoy."
VERSION="1.0.0"
API_V1_PREFIX="/api"

# CORS Allowed Origins (Comma-separated or list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://fastedl.app"

# Rate Limiting & Timeouts
REQUEST_TIMEOUT_SECONDS=20
MAX_DOWNLOAD_SIZE_BYTES=262144000
CHUNK_SIZE=65536

